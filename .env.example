# ============================================================
# AccessGuard — Environment Configuration Template
# ============================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in values below
# 3. NEVER commit .env to version control — it is git-ignored
# ============================================================


# ── Flask ─────────────────────────────────────────────────

# Secret key used to sign session cookies.
# Generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — app will use a random key (lost on restart) if not set.
FLASK_SECRET_KEY=your-very-secret-flask-key-change-me

# Flask environment: development | production
FLASK_ENV=development

# Debug mode: 1 (on) | 0 (off)
# MUST be 0 in production — debug mode exposes an interactive debugger.
FLASK_DEBUG=0

# Port the app listens on (default: 5000)
PORT=5000

# ── Biometric thresholds (optional) ──────────────────────────────────────────
# Face similarity threshold (0–100). Default: 50.0
THRESHOLD_FACE=50.0
# Voice similarity threshold (0–100). Default: 60.0
THRESHOLD_VOICE=60.0


# ── MongoDB ───────────────────────────────────────────────

# Connection URI.
# Local MongoDB:  mongodb://localhost:27017/
# MongoDB Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# REQUIRED — app will not start without a reachable MongoDB instance.
MONGO_URI=mongodb://localhost:27017/

# Name of the database to use.
MONGO_DB_NAME=user_database


# ── Encryption ────────────────────────────────────────────

# Source string for the AES-EAX encryption key.
# Used to encrypt biometric file paths stored in MongoDB.
# Generate a strong one: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — changing this after users are registered will make existing
#            records unreadable (all encrypted paths will fail to decrypt).
ENCRYPTION_SECRET=my_secret_key_change_me
